+            # so "2 * e" and "2e" keep treating 'e' as Euler's constant.
+            if j < len(expr) and expr[j] in 'eE':
+                k = j + 1
+                if k < len(expr) and expr[k] in '+-':
+                    k += 1
+                if k < len(expr) and expr[k].isdigit():
